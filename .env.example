# Active Spring Profile (local = Docker containers, prod = Cloud Services)
SPRING_PROFILES_ACTIVE=local

# Local Database Password (shared by PostgreSQL and MongoDB in docker-compose)
DB_PASSWORD=your_database_password_here

# PostgreSQL Configuration (Local Docker Default)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/SyncStream
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# PostgreSQL Production (Supabase - Used when SPRING_PROFILES_ACTIVE=prod)
# SPRING_DATASOURCE_URL=jdbc:postgresql://<db-ref>.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_supabase_password

# MongoDB Local Connection URI
SPRING_DATA_MONGODB_URI=mongodb://root:your_database_password_here@localhost:27017/syncstream?authSource=admin

# MongoDB Atlas Cluster URI (Used when SPRING_PROFILES_ACTIVE=prod)
# SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/syncstream?retryWrites=true&w=majority

# Redis Local Configuration
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=
SPRING_REDIS_SSL_ENABLED=false

# Redis Upstash Cloud Configuration (Used when SPRING_PROFILES_ACTIVE=prod)
# SPRING_REDIS_HOST=<your-upstash-endpoint>.upstash.io
# SPRING_REDIS_PORT=6379
# SPRING_REDIS_PASSWORD=<your_upstash_password>
# SPRING_REDIS_SSL_ENABLED=true
