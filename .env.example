# Local Database Password (shared by PostgreSQL and MongoDB in docker-compose)
DB_PASSWORD=your_database_password_here

# Spring Boot Configuration Variables
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# Local MongoDB Connection URI
SPRING_DATA_MONGODB_URI=mongodb://root:your_database_password_here@localhost:27017/syncstream?authSource=admin

# Optional: MongoDB Atlas Cluster URI (uncomment and replace with actual credentials if using Atlas)
# SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/syncstream?retryWrites=true&w=majority
